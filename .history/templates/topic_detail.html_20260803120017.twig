{% extends 'base.html.twig' %}

{% block title %}Evounik - {{ topic.title }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{% block body %}
<div class="container">
    <a href="{{ path('app_homepage') }}" class="back-link">← Terug naar overzicht</a>
    <form action="{{ path('app_topic_toggle_homepage', {slug: topic.slug}) }}" method="post" class="toggle-homepage-form">
        <input type="hidden" name="_token" value="{{ csrf_token('toggle_homepage') }}">
        <button type="submit" class="back-link toggle-homepage-button">
            {% if topic.showOnHomepage %}
                Verberg van homepage
            {% else %}
                Toon op homepage
            {% endif %}
        </button>
    </form>
</div>

<div class="hero-image">
    <img src="{{ topic.image ? (topic.image starts with('http') or topic.image starts with('/')) ? topic.image : asset(topic.image) : fallback_image_url() }}" alt="{{ topic.title }}"
         onerror="this.onerror=null; this.src='{{ fallback_image_url() }}';">
</div>

<header class="hero">
    <div class="container">
        <h1>{{ topic.title }}</h1>
        {% if topic.summary %}
        <p>{{ topic.summary }}</p>
        {% endif %}
    </div>
</header>

<main class="container content">
    {% if topic.description %}
    <div class="description">
        <p>{{ topic.description }}</p>
    </div>
    {% endif %}

    {% for block in topic.blocks %}
        {% if block.type == 'text' %}
        <div class="block block-text">
            <p>{{ block.content|nl2br }}</p>
        </div>

        {% elseif block.type == 'image' %}
        <div class="block block-image">
            <img src="{{ block.metadata.url ? (block.metadata.url starts with('http') or block.metadata.url starts with('/')) ? block.metadata.url : asset(block.metadata.url) : fallback_image_url() }}" alt="{{ block.metadata.alt|default('') }}"
                 onerror="this.onerror=null; this.src='{{ fallback_image_url() }}';">
            {% if block.metadata.caption is defined %}
            <div class="caption">{{ block.metadata.caption }}</div>
            {% endif %}
        </div>

        {% elseif block.type == 'text_image' %}
        <div class="block block-text_image{% if block.metadata.side is defined and block.metadata.side == 'left' %} reverse{% endif %}">
            <div class="text-content">
                <p>{{ block.content|nl2br }}</p>
            </div>
            <div class="image-content">
                <img src="{{ block.metadata.url ? (block.metadata.url starts with('http') or block.metadata.url starts with('/')) ? block.metadata.url : asset(block.metadata.url) : fallback_image_url() }}" alt="{{ block.metadata.alt|default('') }}"
                     onerror="this.onerror=null; this.src='{{ fallback_image_url() }}';">
            </div>
        </div>

        {% elseif block.type == 'diagram' %}
        <div class="block block-diagram">
            <div class="diagram-title">{{ block.metadata.title|default('Diagram') }}</div>
            <div class="diagram-container">
                {% if block.metadata.type is defined and block.metadata.type == 'pie' %}
                <svg viewBox="0 0 200 200">
                    {% set total = 0 %}
                    {% for key, val in block.metadata.data %}
                        {% set total = total + val %}
                    {% endfor %}
                    {% set colors = ['#667eea', '#764ba2', '#f093fb', '#4facfe', '#43e97b', '#fa709a'] %}
                    {% set angle = 0 %}
                    {% set color_index = 0 %}
                    {% for key, val in block.metadata.data %}
                        {% set pct = val / total * 360 %}
                        {% set x1 = 100 + 90 * sin(angle * pi / 180) %}
                        {% set y1 = 100 - 90 * cos(angle * pi / 180) %}
                        {% set angle2 = angle + pct %}
                        {% set x2 = 100 + 90 * sin(angle2 * pi / 180) %}
                        {% set y2 = 100 - 90 * cos(angle2 * pi / 180) %}
                        {% set large = pct > 180 ? 1 : 0 %}
                        <path d="M100,100 L{{ x1 }},{{ y1 }} A90,90 0 {{ large }},1 {{ x2 }},{{ y2 }} Z" fill="{{ colors[color_index] }}"/>
                        {% set mid_angle = (angle + angle2) / 2 %}
                        {% set label_x = 100 + 60 * sin(mid_angle * pi / 180) %}
                        {% set label_y = 100 - 60 * cos(mid_angle * pi / 180) %}
                        <text x="{{ label_x }}" y="{{ label_y }}" text-anchor="middle" fill="white" font-size="10" font-weight="bold">{{ key }}</text>
                        {% set angle = angle2 %}
                        {% set color_index = color_index + 1 %}
                    {% endfor %}
                </svg>
                {% elseif block.metadata.type is defined and block.metadata.type == 'bar' %}
                <svg viewBox="0 0 400 250">
                    <line x1="50" y1="220" x2="380" y2="220" stroke="#cbd5e1" stroke-width="2"/>
                    <line x1="50" y1="20" x2="50" y2="220" stroke="#cbd5e1" stroke-width="2"/>
                    {% set colors = ['#667eea', '#764ba2', '#f093fb', '#4facfe', '#43e97b'] %}
                    {% set max_val = 0 %}
                    {% for key, val in block.metadata.data %}
                        {% if val > max_val %}{% set max_val = val %}{% endif %}
                    {% endfor %}
                    {% set bar_width = 300 / (block.metadata.data|length * 2) %}
                    {% set color_index = 0 %}
                    {% for key, val in block.metadata.data %}
                        {% set bar_height = val / max_val * 180 %}
                        {% set x = 70 + color_index * (bar_width * 2) %}
                        {% set y = 220 - bar_height %}
                        <rect x="{{ x }}" y="{{ y }}" width="{{ bar_width }}" height="{{ bar_height }}" rx="4" fill="{{ colors[color_index] }}"/>
                        <text x="{{ x + bar_width / 2 }}" y="{{ y - 8 }}" text-anchor="middle" fill="#1a1a2e" font-size="11" font-weight="bold">{{ val }}%</text>
                        <text x="{{ x + bar_width / 2 }}" y="240" text-anchor="middle" fill="#64748b" font-size="10">{{ key }}</text>
                        {% set color_index = color_index + 1 %}
                    {% endfor %}
                </svg>
                {% elseif block.metadata.type is defined and block.metadata.type == 'line' %}
                <svg viewBox="0 0 400 250">
                    <line x1="50" y1="220" x2="380" y2="220" stroke="#cbd5e1" stroke-width="2"/>
                    <line x1="50" y1="20" x2="50" y2="220" stroke="#cbd5e1" stroke-width="2"/>
                    {% set points = block.metadata.data|length %}
                    {% set max_val = 100 %}
                    {% set step_x = 300 / (points - 1) %}
                    {% set color_index = 0 %}
                    {% set path_d = '' %}
                    {% for key, val in block.metadata.data %}
                        {% set x = 65 + color_index * step_x %}
                        {% set y = 220 - (val / max_val * 180) %}
                        {% set path_d = path_d ~ (color_index == 0 ? 'M' : ' L') ~ x ~ ',' ~ y %}
                        {% set color_index = color_index + 1 %}
                    {% endfor %}
                    <path d="{{ path_d }}" fill="none" stroke="#667eea" stroke-width="3"/>
                    {% set color_index = 0 %}
                    {% for key, val in block.metadata.data %}
                        {% set x = 65 + color_index * step_x %}
                        {% set y = 220 - (val / max_val * 180) %}
                        <circle cx="{{ x }}" cy="{{ y }}" r="5" fill="#667eea"/>
                        <text x="{{ x }}" y="{{ y - 12 }}" text-anchor="middle" fill="#1a1a2e" font-size="10" font-weight="bold">{{ val }}%</text>
                        <text x="{{ x }}" y="240" text-anchor="middle" fill="#64748b" font-size="9">{{ key }}</text>
                        {% set color_index = color_index + 1 %}
                    {% endfor %}
                </svg>
                {% endif %}
            </div>
        </div>
        {% endif %}
    {% endfor %}
</main>

<footer>
    <div class="container">
        &copy; {{ "now"|date("Y") }} Evounik. Alle rechten voorbehouden.
    </div>
</footer>
{% endblock %}