# This file is a "template" of which env vars need to be defined for your application
# Copy this file to .env.local for local development
# DO NOT add this file to git!

# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted environment variables override defaults
#  * .env.local.php      computed environment variables override defaults (this file is generated with the composer dump-env command)
#  * .env.<APP_ENV>      environment variables needed for a specific app environment
#  * .env.<APP_ENV>.local uncommitted environment variables override environment specific defaults

# When building the container, we use the arguments from the .env file
# https://docs.docker.com/compose/environment-variables/
# https://docs.docker.com/compose/env-file/
# https://docs.docker.com/engine/reference/commandline/run/#set-environment-variables--e---env--env-file

# Application
APP_ENV=dev
APP_SECRET=3e5f8a9c2d1b4a6e8f7c9d0e1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b

# Database
DATABASE_URL="mysql://evounik_user:evounik_password@mariadb:3306/evounik_db?serverVersion=10.11"

# Mailer
MAILER_URL=null://localhost

# Redis
REDIS_URL=redis://redis:6379

# CORS
CORS_ALLOW_ORIGIN=^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$