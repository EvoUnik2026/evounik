{% extends 'base.html.twig' %}

{% block title %}Login{% endblock %}

{% block body %}
<main style="max-width:420px;margin:64px auto;padding:32px;background:#fff;border-radius:24px;box-shadow:0 20px 50px rgba(15,23,42,.08);">
    <h1 style="margin-bottom:24px;font-size:1.8rem;color:#111827;">Login</h1>

    {% if error %}
        <div style="margin-bottom:18px;padding:14px 18px;background:#fee2e2;color:#b91c1c;border-radius:12px;">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}

    <form action="/login_check" method="post" style="display:grid;gap:18px;">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <label style="display:block;font-weight:700;color:#111827;">Email</label>
        <input type="email" name="email" value="{{ last_username }}" required autofocus style="width:100%;padding:12px 14px;border:1px solid #d1d5db;border-radius:12px;">

        <label style="display:block;font-weight:700;color:#111827;">Password</label>
        <input type="password" name="password" required style="width:100%;padding:12px 14px;border:1px solid #d1d5db;border-radius:12px;">

        <button type="submit" style="padding:14px 18px;background:#4f46e5;color:#fff;border:none;border-radius:12px;font-weight:700;">Login</button>
    </form>
</main>
{% endblock %}
