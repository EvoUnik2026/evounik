{% extends 'base.html.twig' %}

{% block title %}Register{% endblock %}

{% block body %}
<main style="max-width:520px;margin:64px auto;padding:32px;background:#fff;border-radius:24px;box-shadow:0 20px 50px rgba(15,23,42,.08);">
    <h1 style="margin-bottom:24px;font-size:1.8rem;color:#111827;">Register</h1>

    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div style="margin-bottom:18px;padding:14px 18px;background:#fee2e2;color:#b91c1c;border-radius:12px;">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    <form action="{{ path('app_register') }}" method="post" style="display:grid;gap:18px;">
        <label style="display:block;font-weight:700;color:#111827;">Email</label>
        <input type="email" name="email" required autofocus style="width:100%;padding:12px 14px;border:1px solid #d1d5db;border-radius:12px;">

        <label style="display:block;font-weight:700;color:#111827;">Password</label>
        <input type="password" name="password" required style="width:100%;padding:12px 14px;border:1px solid #d1d5db;border-radius:12px;">

        <label style="display:block;font-weight:700;color:#111827;">Role</label>
        <select name="role" style="width:100%;padding:12px 14px;border:1px solid #d1d5db;border-radius:12px;">
            <option value="ROLE_USER">User</option>
            <option value="ROLE_ADMIN">Admin</option>
            <option value="ROLE_EDITOR">Editor</option>
            <option value="ROLE_REVIEWER">Reviewer</option>
            <option value="ROLE_GUEST">Guest</option>
        </select>

        <button type="submit" style="padding:14px 18px;background:#4f46e5;color:#fff;border:none;border-radius:12px;font-weight:700;">Register</button>
    </form>
</main>
{% endblock %}
