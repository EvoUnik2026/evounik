{% extends 'base.html.twig' %}

{% block title %}Evounik - {{ topic.title }}{% endblock %}

{% block stylesheets %}
<style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        background: #f0f2f5;
        color: #1a1a2e;
        line-height: 1.6;
    }

    .container { max-width: 900px; margin: 0 auto; padding: 0 24px; }

    /* Back link */
    .back-link {
        display: inline-flex; align-items: center; gap: 8px;
        color: #667eea; text-decoration: none; font-weight: 600;
        padding: 20px 0; font-size: 0.95rem;
        transition: gap 0.2s;
    }
    .back-link:hover { gap: 14px; }

    /* Hero */
    .hero {
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
        color: white;
        padding: 60px 0;
        text-align: center;
        position: relative;
        overflow: hidden;
    }
    .hero::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 50px;
        background: #f0f2f5;
        border-radius: 50% 50% 0 0 / 100% 100% 0 0;
    }
    .hero h1 { font-size: 2.4rem; font-weight: 800; margin-bottom: 16px; letter-spacing: -0.5px; }
    .hero p { font-size: 1.1rem; color: #a0aec0; max-width: 650px; margin: 0 auto; }

    /* Hero image */
    .hero-image {
        width: 100%;
        max-height: 400px;
        overflow: hidden;
    }
    .hero-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    /* Content */
    .content { padding: 40px 0 60px; }

    /* Blocks */
    .block {
        background: white;
        border-radius: 16px;
        padding: 32px;
        margin-bottom: 24px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.04);
    }

    .block-text p {
        font-size: 1.05rem;
        color: #334155;
        line-height: 1.8;
    }
    .block-text p + p { margin-top: 16px; }

    .block-image {
        padding: 0;
        overflow: hidden;
    }
    .block-image img {
        width: 100%;
        display: block;
    }
    .block-image .caption {
        padding: 16px 24px;
        font-size: 0.85rem;
        color: #64748b;
        font-style: italic;
        text-align: center;
    }

    .block-text_image {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 32px;
        align-items: center;
        padding: 0;
        overflow: hidden;
    }
    .block-text_image.reverse { direction: rtl; }
    .block-text_image.reverse > * { direction: ltr; }
    .block-text_image .text-content { padding: 32px; }
    .block-text_image .text-content p { font-size: 1.05rem; color: #334155; line-height: 1.8; }
    .block-text_image .image-content { height: 100%; min-height: 250px; overflow: hidden; }
    .block-text_image .image-content img { width: 100%; height: 100%; object-fit: cover; }

    .block-diagram {
        text-align: center;
    }
    .block-diagram .diagram-title {
        font-size: 1.1rem; font-weight: 700; color: #1a1a2e;
        margin-bottom: 20px;
    }
    .block-diagram .diagram-container {
        max-width: 500px;
        margin: 0 auto;
    }
    .block-diagram .diagram-container svg {
        width: 100%;
        height: auto;
    }

    /* Description section */
    .description {
        background: white;
        border-radius: 16px;
        padding: 32px;
        margin-bottom: 24px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.04);
        font-size: 1.05rem;
        color: #334155;
        line-height: 1.8;
    }

    /* Footer */
    footer {
        text-align: center; padding: 32px 0;
        color: #94a3b8; font-size: 0.85rem;
        border-top: 1px solid #e2e8f0;
    }

    @media (max-width: 768px) {
        .block-text_image { grid-template-columns: 1fr; }
        .block-text_image .text-content { padding: 24px; }
        .block-text_image .image-content { min-height: 200px; }
        .hero h1 { font-size: 1.8rem; }
    }
</style>
{% endblock %}

{% block body %}
<div class="container">
    <a href="{{ path('app_homepage') }}" class="back-link">← Terug naar overzicht</a>
    <form action="{{ path('app_topic_toggle_homepage', {slug: topic.slug}) }}" method="post" style="display:inline-block; margin-top: 16px;">
        <input type="hidden" name="_token" value="{{ csrf_token('toggle_homepage') }}">
        <button type="submit" class="back-link" style="display:inline-flex; padding: 8px 14px; background: #fff; border: 1px solid #dfe3e8; border-radius: 999px; color: #1d4ed8; font-weight: 600;">
            {% if topic.showOnHomepage %}
                Verberg van homepage
            {% else %}
                Toon op homepage
            {% endif %}
        </button>
    </form>
</div>

<div class="hero-image">
    <img src="{{ topic.image ? (topic.image starts with('http') or topic.image starts with('/')) ? topic.image : asset(topic.image) : fallback_image_url() }}" alt="{{ topic.title }}"
         onerror="this.onerror=null; this.src='{{ fallback_image_url() }}';">
</div>

<header class="hero">
    <div class="container">
        <h1>{{ topic.title }}</h1>
        {% if topic.summary %}
        <p>{{ topic.summary }}</p>
        {% endif %}
    </div>
</header>

<main class="container content">
    {% if topic.description %}
    <div class="description">
        <p>{{ topic.description }}</p>
    </div>
    {% endif %}

    {% for block in topic.blocks %}
        {% if block.type == 'text' %}
        <div class="block block-text">
            <p>{{ block.content|nl2br }}</p>
        </div>

        {% elseif block.type == 'image' %}
        <div class="block block-image">
            <img src="{{ block.metadata.url ? (block.metadata.url starts with('http') or block.metadata.url starts with('/')) ? block.metadata.url : asset(block.metadata.url) : fallback_image_url() }}" alt="{{ block.metadata.alt|default('') }}"
                 onerror="this.onerror=null; this.src='{{ fallback_image_url() }}';">
            {% if block.metadata.caption is defined %}
            <div class="caption">{{ block.metadata.caption }}</div>
            {% endif %}
        </div>

        {% elseif block.type == 'text_image' %}
        <div class="block block-text_image{% if block.metadata.side is defined and block.metadata.side == 'left' %} reverse{% endif %}">
            <div class="text-content">
                <p>{{ block.content|nl2br }}</p>
            </div>
            <div class="image-content">
                <img src="{{ block.metadata.url ? (block.metadata.url starts with('http') or block.metadata.url starts with('/')) ? block.metadata.url : asset(block.metadata.url) : fallback_image_url() }}" alt="{{ block.metadata.alt|default('') }}"
                     onerror="this.onerror=null; this.src='{{ fallback_image_url() }}';">
            </div>
        </div>

        {% elseif block.type == 'diagram' %}
        <div class="block block-diagram">
            <div class="diagram-title">{{ block.metadata.title|default('Diagram') }}</div>
            <div class="diagram-container">
                {% if block.metadata.type is defined and block.metadata.type == 'pie' %}
                <svg viewBox="0 0 200 200">
                    {% set total = 0 %}
                    {% for key, val in block.metadata.data %}
                        {% set total = total + val %}
                    {% endfor %}
                    {% set colors = ['#667eea', '#764ba2', '#f093fb', '#4facfe', '#43e97b', '#fa709a'] %}
                    {% set angle = 0 %}
                    {% set color_index = 0 %}
                    {% for key, val in block.metadata.data %}
                        {% set pct = val / total * 360 %}
                        {% set x1 = 100 + 90 * sin(angle * pi / 180) %}
                        {% set y1 = 100 - 90 * cos(angle * pi / 180) %}
                        {% set angle2 = angle + pct %}
                        {% set x2 = 100 + 90 * sin(angle2 * pi / 180) %}
                        {% set y2 = 100 - 90 * cos(angle2 * pi / 180) %}
                        {% set large = pct > 180 ? 1 : 0 %}
                        <path d="M100,100 L{{ x1 }},{{ y1 }} A90,90 0 {{ large }},1 {{ x2 }},{{ y2 }} Z" fill="{{ colors[color_index] }}"/>
                        {% set mid_angle = (angle + angle2) / 2 %}
                        {% set label_x = 100 + 60 * sin(mid_angle * pi / 180) %}
                        {% set label_y = 100 - 60 * cos(mid_angle * pi / 180) %}
                        <text x="{{ label_x }}" y="{{ label_y }}" text-anchor="middle" fill="white" font-size="10" font-weight="bold">{{ key }}</text>
                        {% set angle = angle2 %}
                        {% set color_index = color_index + 1 %}
                    {% endfor %}
                </svg>
                {% elseif block.metadata.type is defined and block.metadata.type == 'bar' %}
                <svg viewBox="0 0 400 250">
                    <line x1="50" y1="220" x2="380" y2="220" stroke="#cbd5e1" stroke-width="2"/>
                    <line x1="50" y1="20" x2="50" y2="220" stroke="#cbd5e1" stroke-width="2"/>
                    {% set colors = ['#667eea', '#764ba2', '#f093fb', '#4facfe', '#43e97b'] %}
                    {% set max_val = 0 %}
                    {% for key, val in block.metadata.data %}
                        {% if val > max_val %}{% set max_val = val %}{% endif %}
                    {% endfor %}
                    {% set bar_width = 300 / (block.metadata.data|length * 2) %}
                    {% set color_index = 0 %}
                    {% for key, val in block.metadata.data %}
                        {% set bar_height = val / max_val * 180 %}
                        {% set x = 70 + color_index * (bar_width * 2) %}
                        {% set y = 220 - bar_height %}
                        <rect x="{{ x }}" y="{{ y }}" width="{{ bar_width }}" height="{{ bar_height }}" rx="4" fill="{{ colors[color_index] }}"/>
                        <text x="{{ x + bar_width / 2 }}" y="{{ y - 8 }}" text-anchor="middle" fill="#1a1a2e" font-size="11" font-weight="bold">{{ val }}%</text>
                        <text x="{{ x + bar_width / 2 }}" y="240" text-anchor="middle" fill="#64748b" font-size="10">{{ key }}</text>
                        {% set color_index = color_index + 1 %}
                    {% endfor %}
                </svg>
                {% elseif block.metadata.type is defined and block.metadata.type == 'line' %}
                <svg viewBox="0 0 400 250">
                    <line x1="50" y1="220" x2="380" y2="220" stroke="#cbd5e1" stroke-width="2"/>
                    <line x1="50" y1="20" x2="50" y2="220" stroke="#cbd5e1" stroke-width="2"/>
                    {% set points = block.metadata.data|length %}
                    {% set max_val = 100 %}
                    {% set step_x = 300 / (points - 1) %}
                    {% set color_index = 0 %}
                    {% set path_d = '' %}
                    {% for key, val in block.metadata.data %}
                        {% set x = 65 + color_index * step_x %}
                        {% set y = 220 - (val / max_val * 180) %}
                        {% set path_d = path_d ~ (color_index == 0 ? 'M' : ' L') ~ x ~ ',' ~ y %}
                        {% set color_index = color_index + 1 %}
                    {% endfor %}
                    <path d="{{ path_d }}" fill="none" stroke="#667eea" stroke-width="3"/>
                    {% set color_index = 0 %}
                    {% for key, val in block.metadata.data %}
                        {% set x = 65 + color_index * step_x %}
                        {% set y = 220 - (val / max_val * 180) %}
                        <circle cx="{{ x }}" cy="{{ y }}" r="5" fill="#667eea"/>
                        <text x="{{ x }}" y="{{ y - 12 }}" text-anchor="middle" fill="#1a1a2e" font-size="10" font-weight="bold">{{ val }}%</text>
                        <text x="{{ x }}" y="240" text-anchor="middle" fill="#64748b" font-size="9">{{ key }}</text>
                        {% set color_index = color_index + 1 %}
                    {% endfor %}
                </svg>
                {% endif %}
            </div>
        </div>
        {% endif %}
    {% endfor %}
</main>

<footer>
    <div class="container">
        &copy; {{ "now"|date("Y") }} Evounik. Alle rechten voorbehouden.
    </div>
</footer>
{% endblock %}