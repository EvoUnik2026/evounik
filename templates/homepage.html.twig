{% extends 'base.html.twig' %}

{% block title %}Evounik - Home{% endblock %}

{% block body %}


<main class="container">
    <div class="topics-grid">
        {% for topic in topics %}
        <article class="topic-card">
            {% include 'components/topic_image.html.twig' with { image: topic.image, alt: topic.title, width: 640, height: 400 } %}
            <div class="topic-card-body">
                <div class="topic-card-category">Topic</div>
                <h2><a href="{{ path('app_topic_detail', {slug: topic.slug}) }}">{{ topic.title }}</a></h2>
                <p>{{ topic.summary }}</p>
            </div>
            <div class="topic-card-footer">
                <span class="block-count">{{ topic.blocks|length }} blok{% if topic.blocks|length != 1 %}ken{% endif %}</span>
                <a href="{{ path('app_topic_detail', {slug: topic.slug}) }}" class="read-more">
                    Lees meer <span>→</span>
                </a>
            </div>
        </article>
        {% else %}
        <p style="grid-column: 1 / -1; text-align: center; padding: 60px 0; color: #94a3b8;">
            Nog geen topics beschikbaar.
        </p>
        {% endfor %}
    </div>
</main>

<footer>
    <div class="container">
        &copy; {{ "now"|date("Y") }} Evounik. Alle rechten voorbehouden.
    </div>
</footer>
{% endblock %}
