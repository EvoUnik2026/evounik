{% extends 'base.html.twig' %}


{% block title %}Admin - Bewerk {{ topic.title }}{% endblock %}

{% block body %}
<div class="max-w-5xl mx-auto">
    <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
        <div>
            <a href="{{ path('app_admin_topics') }}" class="text-sm font-semibold text-indigo-600 hover:text-indigo-800">← Terug naar topics</a>
            <h1 class="mt-1 text-2xl font-black tracking-tight text-slate-900">Bewerk topic: {{ topic.title }}</h1>
        </div>
        <a href="{{ path('app_topic_detail', {slug: topic.slug}) }}" target="_blank"
           class="rounded-full bg-indigo-600 px-4 py-2 text-sm font-bold text-white hover:bg-indigo-700">
            Bekijk live →
        </a>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="mb-4 rounded-xl px-4 py-3 border
                {{ label == 'error' ? 'bg-red-50 border-red-200 text-red-700' : 'bg-emerald-50 border-emerald-200 text-emerald-700' }}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    <div class="grid gap-6">
        {# ---- Topic fields ---- #}
        <section class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
            <h2 class="mb-4 text-lg font-bold text-slate-800">Topic gegevens</h2>
            <form method="post" action="{{ path('app_admin_topic_edit', {id: topic.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('topic_edit') }}">

                <div class="grid gap-4 sm:grid-cols-2">
                    <div>
                        <label class="mb-1 block text-sm font-semibold text-slate-600">Titel</label>
                        <input type="text" name="title" value="{{ topic.title }}" required
                               class="w-full rounded-lg border border-slate-300 px-3 py-2 focus:border-indigo-500 focus:outline-none">
                    </div>
                    <div>
                        <label class="mb-1 block text-sm font-semibold text-slate-600">Slug</label>
                        <input type="text" name="slug" value="{{ topic.slug }}"
                               placeholder="automatisch gegenereerd"
                               class="w-full rounded-lg border border-slate-300 px-3 py-2 focus:border-indigo-500 focus:outline-none">
                    </div>
                    <div class="sm:col-span-2">
                        <label class="mb-1 block text-sm font-semibold text-slate-600">Afbeelding (pad of URL)</label>
                        <input type="text" name="image" value="{{ topic.image ?? '' }}"
                               placeholder="/images/energy.jpg of https://…"
                               class="w-full rounded-lg border border-slate-300 px-3 py-2 focus:border-indigo-500 focus:outline-none">
                    </div>
                    <div class="sm:col-span-2">
                        <label class="mb-1 block text-sm font-semibold text-slate-600">Samenvatting</label>
                        <textarea name="summary" rows="2"
                                  class="w-full rounded-lg border border-slate-300 px-3 py-2 focus:border-indigo-500 focus:outline-none">{{ topic.summary ?? '' }}</textarea>
                    </div>
                    <div class="sm:col-span-2">
                        <label class="mb-1 block text-sm font-semibold text-slate-600">Beschrijving</label>
                        <textarea name="description" rows="4"
                                  class="w-full rounded-lg border border-slate-300 px-3 py-2 focus:border-indigo-500 focus:outline-none">{{ topic.description ?? '' }}</textarea>
                    </div>
                    <div>
                        <label class="mb-1 block text-sm font-semibold text-slate-600">Positie (homepage)</label>
                        <input type="number" name="position" value="{{ topic.position }}" min="0"
                               class="w-full rounded-lg border border-slate-300 px-3 py-2 focus:border-indigo-500 focus:outline-none">
                    </div>
                    <div class="flex items-end pb-2">
                        <label class="flex items-center gap-2 text-sm font-semibold text-slate-600">
                            <input type="checkbox" name="showOnHomepage" value="1" {% if topic.showOnHomepage %}checked{% endif %}
                                   class="h-4 w-4 rounded border-slate-300 text-indigo-600">
                            Toon op homepage
                        </label>
                    </div>
                </div>

                <div class="mt-5">
                    <button type="submit" class="rounded-full bg-indigo-600 px-5 py-2 font-bold text-white hover:bg-indigo-700">
                        Topic opslaan
                    </button>
                </div>
            </form>
        </section>

        {# ---- Block management ---- #}
        <section class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
            <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
                <h2 class="text-lg font-bold text-slate-800">Blokken ({{ topic.blocks|length }})</h2>

                <form method="post" action="{{ path('app_admin_block_new', {id: topic.id}) }}" class="flex items-center gap-2">
                    <input type="hidden" name="_token" value="{{ csrf_token('block_new') }}">
                    <select name="type" class="rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:outline-none">
                        {% for type in blockTypes %}
                            <option value="{{ type }}">{{ type|replace({'_': ' '})|title }}</option>
                        {% endfor %}
                    </select>
                    <button type="submit" class="rounded-full bg-emerald-600 px-4 py-2 text-sm font-bold text-white hover:bg-emerald-700">
                        + Blok toevoegen
                    </button>
                </form>
            </div>

            {% if topic.blocks|length == 0 %}
                <p class="rounded-xl bg-slate-50 px-4 py-6 text-center text-sm text-slate-500">
                    Nog geen blokken. Voeg hierboven je eerste blok toe.
                </p>
            {% else %}
                <ol class="space-y-3">
                    {% for block in topic.blocks %}
                        <li class="rounded-xl border border-slate-200 bg-slate-50/60 p-4">
                            <div class="flex flex-wrap items-center justify-between gap-3">
                                <div class="min-w-0">
                                    <div class="flex items-center gap-2">
                                        <span class="rounded-full bg-indigo-100 px-2.5 py-0.5 text-xs font-bold text-indigo-700">{{ block.type|replace({'_': ' '})|title }}</span>
                                        <span class="text-xs font-semibold text-slate-400">positie {{ block.position }}</span>
                                    </div>
                                    <p class="mt-1 truncate text-sm text-slate-500">
                                        {% if block.type == 'text' or block.type == 'text_image' %}
                                            {{ (block.content ?? '')|striptags|slice(0, 90) }}{% if (block.content ?? '')|length > 90 %}…{% endif %}
                                        {% elseif block.type == 'image' %}
                                            {{ block.metadata.url ?? 'geen afbeelding' }}
                                        {% elseif block.type == 'diagram' %}
                                            {{ (block.metadata.title ?? 'Diagram') ~ ' (' ~ (block.metadata.data|default([])|length) ~ ' categorieën)' }}
                                        {% endif %}
                                    </p>
                                </div>

                                <div class="flex items-center gap-1.5">
                                    <form method="post" action="{{ path('app_admin_block_move', {id: block.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('block_move_' ~ block.id) }}">
                                        <input type="hidden" name="direction" value="up">
                                        <button type="submit" title="Omhoog" {% if loop.first %}disabled{% endif %}
                                                class="rounded-lg border border-slate-300 px-2.5 py-1 text-sm font-semibold text-slate-600 hover:bg-slate-100 disabled:opacity-30">↑</button>
                                    </form>
                                    <form method="post" action="{{ path('app_admin_block_move', {id: block.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('block_move_' ~ block.id) }}">
                                        <input type="hidden" name="direction" value="down">
                                        <button type="submit" title="Omlaag" {% if loop.last %}disabled{% endif %}
                                                class="rounded-lg border border-slate-300 px-2.5 py-1 text-sm font-semibold text-slate-600 hover:bg-slate-100 disabled:opacity-30">↓</button>
                                    </form>
                                    <a href="{{ path('app_admin_block_edit', {id: block.id}) }}"
                                       class="rounded-lg bg-indigo-600 px-3 py-1 text-sm font-bold text-white hover:bg-indigo-700">Bewerken</a>
                                    <form method="post" action="{{ path('app_admin_block_delete', {id: block.id}) }}"
                                          onsubmit="return confirm('Dit blok verwijderen?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('block_delete') }}">
                                        <button type="submit" class="rounded-lg bg-red-600 px-3 py-1 text-sm font-bold text-white hover:bg-red-700">Verwijder</button>
                                    </form>
                                </div>
                            </div>
                        </li>
                    {% endfor %}
                </ol>
            {% endif %}
        </section>
    </div>
</div>
{% endblock %}
